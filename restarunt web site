                        <p>git add index.html</p>
                        <p>git commit -m "Add Ruchi's North & South Indian Menu Card"</p>
                        <br>
                        <p class="text-slate-400"># 3. Create a main branch & link to your GitHub repo</p>
                        <p>git branch -M main</p>
                        <p>git remote add origin https://github.com/YOUR_USERNAME/ruchis-restaurant-menu.git</p>
                        <br>
                        <p class="text-slate-400"># 4. Push code to GitHub</p>
                        <p>git push -u origin main</p>
