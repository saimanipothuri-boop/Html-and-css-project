        // Application State
        let currentStyle = 'All';
        let currentCategory = 'All';
        let currentDiet = 'all'; // 'all', 'veg', 'nonveg'
        let searchQuery = '';
        let cart = [];

        // DOM Element references
        const menuGrid = document.getElementById('menuGrid');
        const emptyState = document.getElementById('emptyState');
        const resultCount = document.getElementById('resultCount');
        const currentCategoryTitle = document.getElementById('currentCategoryTitle');

        // Main function to render menu cards
        function renderMenu() {
            let filtered = menuItems.filter(item => {
                // Style filter (North vs South)
                if (currentStyle !== 'All' && item.style !== currentStyle) return false;
                
                // Category filter
                if (currentCategory !== 'All' && item.category !== currentCategory) return false;

                // Diet filter
                if (currentDiet === 'veg' && !item.isVeg) return false;
                if (currentDiet === 'nonveg' && item.isVeg) return false;

                // Search Query
                if (searchQuery.trim() !== '') {
                    const q = searchQuery.toLowerCase();
                    const matchName = item.name.toLowerCase().includes(q);
                    const matchDesc = item.description.toLowerCase().includes(q);
                    const matchStyle = item.style.toLowerCase().includes(q);
                    if (!matchName && !matchDesc && !matchStyle) return false;
                }

                return true;
            });

            // Update counter
            resultCount.innerText = filtered.length;

            if (filtered.length === 0) {
                menuGrid.classList.add('hidden');
                emptyState.classList.remove('hidden');
                return;
            }

            menuGrid.classList.remove('hidden');
            emptyState.classList.add('hidden');

            menuGrid.innerHTML = filtered.map(item => createMenuCardHTML(item)).join('');
        }

        // Generate individual HTML card
        function createMenuCardHTML(item) {
            // Spice rating flames
            const spiceFlames = Array(item.spiceLevel).fill('🌶️').join('');
            
            // Veg / Non-Veg Icon
            const dietIcon = item.isVeg 
                ? `<span class="w-4 h-4 border-2 border-emerald-600 p-0.5 flex items-center justify-center rounded-sm bg-white" title="Pure Vegetarian"><span class="w-2 h-2 bg-emerald-600 rounded-full"></span></span>`
                : `<span class="w-4 h-4 border-2 border-red-600 p-0.5 flex items-center justify-center rounded-sm bg-white" title="Non-Vegetarian"><span class="w-2 h-2 bg-red-600 rounded-full"></span></span>`;

            // Style Badge Tag
            const styleBadge = item.style === 'South Indian' 
                ? `<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded border border-emerald-300">🌴 South Style</span>`
                : `<span class="bg-amber-100 text-amber-900 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-300">🏔️ North Style</span>`;

            // Bestseller badge
            const bestsellerBadge = item.isBestseller 
                ? `<span class="bg-gradient-to-r from-saffron-500 to-amber-600 text-white font-bold text-[10px] px-2 py-0.5 rounded-full shadow-sm">★ Bestseller</span>`
                : '';

            return `
                <div class="print-card bg-white rounded-2xl border border-amber-200/70 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col justify-between group">
                    <div>
                        <!-- Image & Top Badges -->
                        <div class="relative h-44 overflow-hidden bg-slate-100">
                            <img src="${item.image}" alt="${item.name}" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                            
                            <div class="absolute top-3 left-3 flex items-center gap-1.5">
                                ${dietIcon}
                                ${bestsellerBadge}
                            </div>

                            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-white">
                                ${styleBadge}
                                <span class="text-xs font-semibold bg-black/50 backdrop-blur-md px-2 py-0.5 rounded text-amber-200" title="Spice level">${spiceFlames}</span>
                            </div>
                        </div>

                        <!-- Details Section -->
                        <div class="p-4 space-y-2">
                            <div class="flex items-start justify-between gap-2">
                                <h4 class="font-serif font-bold text-base text-slate-900 group-hover:text-maroon-800 transition">${item.name}</h4>
                                <span class="font-sans font-extrabold text-base text-maroon-800 whitespace-nowrap">₹${item.price}</span>
                            </div>
                            <p class="text-slate-600 text-xs line-clamp-2 leading-relaxed">${item.description}</p>
                        </div>
                    </div>

                    <!-- Add to Plate Button -->
                    <div class="px-4 pb-4 pt-1 no-print">
                        <button onclick="addToCart(${item.id})" class="w-full py-2 bg-amber-100 hover:bg-saffron-600 hover:text-white text-maroon-800 font-bold rounded-xl text-xs flex items-center justify-center gap-2 transition duration-200 shadow-sm active:scale-[0.98]">
                            <i class="fa-solid fa-plus text-xs"></i> Add to Order Plate
                        </button>
                    </div>
                </div>
            `;
        }

        // Filtering handlers
        function filterByStyle(style) {
            currentStyle = style;
            document.querySelectorAll('.style-tab').forEach(btn => btn.classList.remove('active-tab', 'bg-maroon-800', 'text-white'));
            
            const activeBtn = document.getElementById(`style-btn-${style}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-maroon-800', 'text-white');
            }

            updateTitleText();
            renderMenu();
        }

        function filterByCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-maroon-800', 'text-white');
                btn.classList.add('bg-white', 'text-slate-700');
            });
            event.target.classList.remove('bg-white', 'text-slate-700');
            event.target.classList.add('bg-maroon-800', 'text-white');

            updateTitleText();
            renderMenu();
        }

        function toggleDietFilter(type) {
            currentDiet = type;
            document.querySelectorAll('.diet-badge').forEach(b => b.classList.remove('bg-amber-100', 'text-amber-800', 'font-bold'));
            document.getElementById(`diet-${type}`).classList.add('bg-amber-100', 'text-amber-800', 'font-bold');
            renderMenu();
        }

        function handleSearch() {
            searchQuery = document.getElementById('searchInput').value;
            renderMenu();
        }

        function resetFilters() {
            currentStyle = 'All';
            currentCategory = 'All';
            currentDiet = 'all';
            searchQuery = '';
            document.getElementById('searchInput').value = '';
            filterByStyle('All');
        }

        function updateTitleText() {
            if (currentStyle === 'All' && currentCategory === 'All') {
                currentCategoryTitle.innerText = "Full Menu Highlights";
            } else if (currentStyle !== 'All') {
                currentCategoryTitle.innerText = `${currentStyle} Specialties`;
            } else {
                currentCategoryTitle.innerText = `${currentCategory}`;
            }
        }

        // Cart / Bill Estimator Logic
        function addToCart(itemId) {
            const item = menuItems.find(i => i.id === itemId);
            if (!item) return;

            const existing = cart.find(c => c.id === itemId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ ...item, quantity: 1 });
            }

            updateCartUI();
            
            // Subtle toast / trigger cart open if first item
            if (cart.length === 1) {
                toggleCartDrawer(true);
            }
        }

        function updateCartQuantity(itemId, delta) {
            const idx = cart.findIndex(c => c.id === itemId);
            if (idx > -1) {
                cart[idx].quantity += delta;
                if (cart[idx].quantity <= 0) {
                    cart.splice(idx, 1);
                }
            }
            updateCartUI();
        }

        function clearCart() {
            cart = [];
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cartItemsContainer');
            const totalBadge = document.getElementById('cartCountBadge');
            const subtotalEl = document.getElementById('cartSubtotal');
            const taxEl = document.getElementById('cartTax');
            const totalEl = document.getElementById('cartTotal');

            const totalCount = cart.reduce((acc, curr) => acc + curr.quantity, 0);
            totalBadge.innerText = totalCount;

            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-basket-shopping text-4xl mb-2 text-slate-300"></i>
                        <p class="text-sm">Your plate is currently empty.</p>
                        <p class="text-xs text-slate-400 mt-1">Tap standard dishes to add to your order estimation.</p>
                    </div>
                `;
                subtotalEl.innerText = '₹0';
                taxEl.innerText = '₹0';
                totalEl.innerText = '₹0';
                return;
            }

            let subtotal = 0;
            container.innerHTML = cart.map(c => {
                const itemTotal = c.price * c.quantity;
                subtotal += itemTotal;
                return `
                    <div class="py-2.5 flex items-center justify-between gap-2">
                        <div class="flex-grow">
                            <h5 class="text-xs font-bold text-slate-800">${c.name}</h5>
                            <p class="text-[11px] text-slate-500">₹${c.price} x ${c.quantity} = <span class="font-semibold text-slate-700">₹${itemTotal}</span></p>
                        </div>
                        <div class="flex items-center gap-1.5 bg-slate-100 rounded-lg p-1">
                            <button onclick="updateCartQuantity(${c.id}, -1)" class="w-6 h-6 flex items-center justify-center bg-white rounded text-slate-700 text-xs font-bold shadow-sm">-</button>
                            <span class="text-xs font-bold px-1">${c.quantity}</span>
                            <button onclick="updateCartQuantity(${c.id}, 1)" class="w-6 h-6 flex items-center justify-center bg-white rounded text-slate-700 text-xs font-bold shadow-sm">+</button>
                        </div>
                    </div>
                `;
            }).join('');

            const tax = Math.round(subtotal * 0.05); // 5% GST
            const grandTotal = subtotal + tax;

            subtotalEl.innerText = `₹${subtotal}`;
            taxEl.innerText = `₹${tax}`;
            totalEl.innerText = `₹${grandTotal}`;
        }

        function toggleCartDrawer(forceOpen = false) {
            const drawer = document.getElementById('cartDrawer');
            if (forceOpen) {
                drawer.classList.remove('translate-x-full');
            } else {
                drawer.classList.toggle('translate-x-full');
            }
        }

        function toggleModal(modalId) {
            const modal = document.getElementById(modalId);
            modal.classList.toggle('hidden');
        }

        function copyOrderSummary() {
            if (cart.length === 0) return;
            
            let text = "🍽️ *Ruchi's Restaurant - Order Request*\n\n";
            let subtotal = 0;
            cart.forEach(item => {
                const total = item.price * item.quantity;
                subtotal += total;
                text += `• ${item.name} x${item.quantity} - ₹${total}\n`;
            });
            
            const tax = Math.round(subtotal * 0.05);
            text += `\n*Subtotal:* ₹${subtotal}`;
            text += `\n*GST (5%):* ₹${tax}`;
            text += `\n*Estimated Total:* ₹${subtotal + tax}`;
            text += `\n\nThank you for dining at Ruchi's!`;

            navigator.clipboard.writeText(text).then(() => {
                alert("Order summary copied to clipboard! You can now paste it into WhatsApp or notes.");
            });
        }

        // Initialize on page load
        window.addEventListener('DOMContentLoaded', () => {
            filterByStyle('All');
        });
    </script>
